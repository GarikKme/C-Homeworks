@model Teacher

<div class="container shadow p-5">
    <div class="row pb-2">
        <h2>Delete Teacher</h2>
    </div>

    <form method="post" asp-action="DeleteTeacher">
        <input asp-for="Id" hidden />
        <div asp-validation-summary="All"></div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Name">Teacher Name</label>
                <input type="text" class="form-control mb-3" asp-for="Name" placeholder="Enter Name" disabled>
                <span asp-validation-for="Name" class=" alert-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Email">Email</label>
                <input type="number" class="form-control mb-3" asp-for="Email" placeholder="Enter Email" disabled>
                <span asp-validation-for="Email" class=" alert-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Subject">Subject</label>
                <input type="text" class="form-control mb-3" asp-for="Subject" placeholder="Enter Subject" disabled>
                <span asp-validation-for="Subject" class=" alert-danger"></span>
            </div>
            <div class="form-group col-md-6 mb-3">
                <label asp-for="CreatedAt">Created At</label>
                <input type="datetime-local" class="form-control" asp-for="CreatedAt" disabled>
                <span asp-validation-for="CreatedAt" class=" alert-danger"></span>
            </div>
        </div>


        <button type="submit" class="btn btn-lg btn-danger p-2"><i class="bi bi-trash-fill"></i>Delete</button>
        <a asp-controller="Teacher" asp-action="Index" class="btn btn-lg btn-warning p-2">Back To List</a>
    </form>

</div>


@*//for front end validations*@

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}