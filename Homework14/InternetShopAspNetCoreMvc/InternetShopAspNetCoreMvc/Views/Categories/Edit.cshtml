@model Category

@{
    ViewData["Title"] = "Edit";
    ViewData["ShowHiddenFields"] = true;
}

<h1 class="center">Edit category</h1>
<hr />
<div class="row">
    <div class="col-md-16">
        <form asp-action="Edit">
            @await Html.PartialAsync("_CategoryForm", Model)
            <div class="form-group center m-3">
                <input type="submit" value="Save" class="btn btn-primary width-200-px" />
            </div>
            <div class="form-group center m-3">
                <a class="btn btn-secondary width-200-px" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
